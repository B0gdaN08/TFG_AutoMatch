# Variables del frontend (Vite las lee en BUILD, no en ejecucion).
# Copia a .env si necesitas cambiar el valor en desarrollo.

# URL del backend. Sin definir -> http://localhost:8080 (desarrollo).
# Vacia (VITE_API_URL=) -> rutas relativas; util detras de un proxy como
# el nginx del Dockerfile, que reenvia /api, /uploads e /images al backend.
VITE_API_URL=http://localhost:8080
