# ============================================================
# Variables de entorno de AutoMatch (docker compose / produccion)
# Copia este fichero a .env y ajusta los valores.
# ============================================================

# --- Obligatorio: clave de firma de los JWT (minimo 32 caracteres, usa una aleatoria) ---
# Generar una, por ejemplo:  openssl rand -base64 48
APP_JWT_SECRET=

# --- Contrasena de PostgreSQL (docker compose la pasa a db y backend) ---
POSTGRES_PASSWORD=automatch

# ------------------------------------------------------------
# Variables que el backend admite ademas de las de arriba
# (docker-compose.yml ya define las de la base de datos):
#
#   SPRING_PROFILES_ACTIVE      dev (defecto) | prod
#   SPRING_DATASOURCE_URL       jdbc:postgresql://host:5432/automatch
#   SPRING_DATASOURCE_USERNAME  usuario de la BD
#   SPRING_DATASOURCE_PASSWORD  contrasena de la BD
#   APP_CORS_ORIGINS            origenes permitidos, separados por comas
#   APP_SEED_ADMIN_PASSWORD     contrasena inicial del admin (solo si la BD no tiene usuarios)
#   APP_SEED_DEMO_PASSWORD      contrasena inicial del usuario demo
#
# Variables del frontend (en build, ver frontend/.env.example):
#
#   VITE_API_URL                URL del backend; vacia = rutas relativas (nginx hace proxy)
# ------------------------------------------------------------
